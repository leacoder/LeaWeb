# Valores opcionales; el sitio funciona sin servicios de Google.
# Código de verificación HTML de Search Console (solo el contenido del meta).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Identificador GA4 válido, por ejemplo G-XXXXXXXXXX.
# Se usa para registrar contact_click con el canal de contacto.
PUBLIC_GA_MEASUREMENT_ID=

# Opcional: identificador de FormSubmit recibido después de activar el correo.
# Sin este valor, usa lg.design.web@gmail.com. Es público, no una clave privada.
PUBLIC_FORMSUBMIT_ID=
