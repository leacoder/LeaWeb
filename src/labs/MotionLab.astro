---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Blueprint from '../components/AnimatedBlueprint.astro';
import BlueprintReality from '../components/BlueprintReality.astro';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Del plano a la realidad · Laboratorio LG Design</title>
  </head>
  <body>
    <main class="motion-lab">
      <header class="lab-header"><a href="/" aria-label="LG Design, volver al inicio"><img src="/logo-light.svg" width="160" height="42" alt="LG Design" /></a><span>Laboratorio de movimiento</span></header>
      <section class="experiment" aria-labelledby="lab-title">
        <canvas id="motion-grid" aria-hidden="true"></canvas>
        <div class="lab-copy">
          <h1 id="lab-title">Una idea. <br />Un plano. <br /><span>Algo real.</span></h1>
          <p>Primero las líneas. Después, los detalles, el color y la vida. Del plano a una web que toma forma.</p>
          <button class="play-button" id="build-play" type="button" disabled>Ver construcción</button>
          <p class="pointer-hint">Mové el mouse sobre el fondo o tocá la cuadrícula.</p>
        </div>
        <div class="lab-drawing"><Blueprint><BlueprintReality /></Blueprint></div>
      </section>
      <section class="lab-console" aria-label="Controles de la prueba">
        <div class="sequence-controls">
          <div class="sequence-heading"><label for="build-progress">Construcción del plano</label><output id="build-step" aria-live="polite">Plano completo</output></div>
          <input id="build-progress" type="range" min="0" max="100" step="1" value="100" aria-label="Avance de la construcción" disabled />
          <div class="sequence-legend" aria-hidden="true"><span>Estructura</span><span>Diseño</span><span>Plano</span><span>Realidad</span></div>
        </div>
        <div class="grid-controls">
          <span id="grid-label">Respuesta de la cuadrícula</span>
          <div class="grid-options" role="group" aria-labelledby="grid-label">
            <button type="button" data-grid-mode="light" aria-pressed="false">Luz</button>
            <button type="button" data-grid-mode="elastic" aria-pressed="true">Elástica</button>
            <button type="button" data-grid-mode="snap" aria-pressed="false">Mira técnica</button>
          </div>
          <p id="grid-description">La retícula acompaña el movimiento y recupera su forma suavemente.</p>
        </div>
      </section>
      <footer class="lab-footer"><p>Prueba de movimiento sobre tu blueprint actual.</p><a href="/">Volver a la web</a></footer>
    </main>
    <script src="../scripts/motion-lab.ts"></script>
  </body>
</html>
<style>
  .motion-lab { max-width: 1600px; margin: auto; padding: 0 clamp(20px, 4.8vw, 80px); }
  .lab-header { min-height: 100px; display: flex; justify-content: space-between; align-items: center; gap: 20px; border-bottom: 1px solid var(--line); }
  .lab-header img { width: 160px; height: auto; }
  .lab-header > span { color: var(--muted); font-size: 13px; }
  .experiment { position: relative; isolation: isolate; display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: clamp(24px, 5vw, 80px); padding: 42px 0; }
  #motion-grid { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .lab-copy h1 { font-size: clamp(48px, 5.8vw, 84px); letter-spacing: -.04em; line-height: 1.06; }
  .lab-copy h1 span { color: var(--accent); }
  .lab-copy > p { max-width: 36ch; margin-top: 25px; font-size: 17px; }
  .play-button { display: inline-flex; justify-content: space-between; align-items: center; gap: 40px; min-height: 52px; margin-top: 30px; padding: 12px 20px; background: var(--accent); color: var(--ink); border: 1px solid var(--accent); font-weight: 600; }
  .play-button:hover { background: #b9f2fa; }
  button:disabled { opacity: .5; cursor: default; }
  .lab-copy .pointer-hint { font-size: 12px; max-width: 40ch; margin-top: 18px; }
  .lab-drawing { min-width: 0; }
  .lab-drawing :global(.blueprint) { width: 100%; max-width: none; margin: 0; }
  .lab-drawing :global(.blueprint-controls), .lab-drawing :global(.blueprint-bottom) { display: none; }
  .lab-drawing :global(.blueprint-stage) { background: transparent; }
  .lab-drawing :global(.blueprint-drawing > rect:first-of-type) { fill: transparent; }
  .lab-drawing :global(.plan-trace), .lab-drawing :global(.plan-copy), .lab-drawing :global(.plan-measurements), .lab-drawing :global(.plan-scan), .lab-drawing :global(.plan-beacon) { animation: none; }
  .lab-console { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(28px, 7vw, 100px); padding: 28px 0 35px; border-block: 1px solid var(--line); font-size: 13px; }
  .sequence-heading { display: flex; justify-content: space-between; gap: 15px; }
  #build-step { color: var(--accent); }
  #build-progress { width: 100%; height: 30px; margin: 13px 0 3px; accent-color: var(--accent); cursor: ew-resize; }
  .sequence-legend { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; color: var(--muted); }
  .grid-options { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .grid-options button { background: transparent; border: 1px solid var(--line); color: var(--muted); min-height: 44px; padding: 8px 13px; font-size: 13px; }
  .grid-options button:hover { color: var(--text); border-color: var(--accent); }
  .grid-options button[aria-pressed='true'] { color: var(--accent); border-color: var(--accent); background: rgba(139,226,239,.06); }
  #grid-description { font-size: 12px; margin-top: 9px; }
  .lab-footer { padding: 20px 0; display: flex; justify-content: space-between; gap: 20px; font-size: 12px; }
  .lab-footer a { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 740px) {
    .lab-header { min-height: 80px; }
    .lab-header > span { max-width: 120px; text-align: right; font-size: 11px; }
    .experiment { grid-template-columns: 1fr; padding-top: 30px; gap: 24px; }
    .lab-copy h1 { font-size: clamp(44px, 9vw, 62px); }
    .lab-copy h1 br { display: none; }
    .lab-copy h1 span { display: block; }
    .lab-copy > p { font-size: 15px; margin-top: 18px; }
    .play-button { margin-top: 20px; }
    .lab-console { grid-template-columns: 1fr; gap: 30px; }
    .lab-footer { flex-wrap: wrap; }
  }
</style>
