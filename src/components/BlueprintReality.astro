---
import { getImage } from 'astro:assets';
import library from '../assets/projects/libreria2001.jpg';
import vybe from '../assets/projects/matchvybe.png';
const [libraryImage, vybeImage] = await Promise.all([
  getImage({ src: library, width: 420, format: 'webp' }),
  getImage({ src: vybe, width: 420, format: 'webp' }),
]);
---
<!-- Same coordinates as the original plan: the finished surfaces replace
     their own wireframes without a cut to an unrelated composition. -->
<defs>
  <clipPath id="reality-desktop-mask"><rect data-reality-desktop-mask x="64" y="87" width="0" height="252" rx="3" /></clipPath>
  <clipPath id="reality-mobile-mask"><rect data-reality-mobile-mask x="366" y="197" width="126" height="0" rx="12" /></clipPath>
  <mask id="reality-phone-occlusion" maskUnits="userSpaceOnUse" x="64" y="87" width="362" height="252"><rect x="64" y="87" width="362" height="252" fill="white" /><rect x="367" y="198" width="124" height="220" rx="12" fill="black" /></mask>
</defs>
<g class="reality" style="opacity:0" font-family="Inter Variable, sans-serif">
  <g clip-path="url(#reality-desktop-mask)" mask="url(#reality-phone-occlusion)">
    <rect x="65" y="88" width="360" height="250" rx="3" fill="#071a2e" stroke="#56798c" stroke-width=".7" />
    <path d="M68 88h354a3 3 0 0 1 3 3v18H65V91a3 3 0 0 1 3-3" fill="#183248" />
    <circle cx="77" cy="98" r="1.7" fill="#f28e85" /><circle cx="85" cy="98" r="1.7" fill="#f0ce7b" /><circle cx="93" cy="98" r="1.7" fill="#88c7a5" />
    <rect x="174" y="92" width="143" height="12" rx="3" fill="#10263a" />
    <text x="245" y="100" text-anchor="middle" fill="#b8ccdb" font-size="5.4">lgdesign.com.ar</text>
    <image href="/logo-light.svg" x="81" y="114" width="69" height="21" />
    <g fill="#b8cbd9" font-size="6.3"><text x="252" y="125">Servicios</text><text x="291" y="125">Proyectos</text><text x="336" y="125">Sobre mí</text></g>
    <rect x="374" y="116" width="40" height="13" rx="2" fill="#8be2ef" /><text x="381" y="125" font-size="6.3" fill="#071a2e">Hablemos</text>
    <path d="M65 138h360" stroke="#243e53" stroke-width=".5" />
    <text x="84" y="155" font-size="5.4" fill="#8be2ef" letter-spacing=".4">DE LA IDEA A LA REALIDAD</text>
    <g fill="#edf3f8" font-size="20" font-weight="600" letter-spacing="-.8"><text x="83" y="180">Diseñar y</text><text x="83" y="202" fill="#8be2ef">construir.</text></g>
    <text x="84" y="216" font-size="6.8" fill="#b8cbd9">El próximo paso de tu proyecto.</text>
    <rect x="84" y="227" width="106" height="18" rx="2" fill="#8be2ef" />
    <text x="94" y="238.5" font-size="6.6" font-weight="600" fill="#071a2e">Contame tu proyecto</text><path d="m177 237 5-5m-5 0h5v5" stroke="#071a2e" stroke-width=".7" />
    <rect x="269" y="153" width="128" height="82" rx="4" fill="#102c43" />
    <image href="/logo-light.svg" x="282" y="174" width="102" height="31" />
    <path d="M283 216h99" stroke="#315268" stroke-width=".5" />
    <text x="333" y="226" text-anchor="middle" font-size="4.4" letter-spacing="1" fill="#b8cbd9">IDEAS QUE TOMAN FORMA</text>
    <rect x="84" y="258" width="152" height="62" rx="3" fill="#173147" />
    <rect x="252" y="258" width="152" height="62" rx="3" fill="#173147" />
    <image href={libraryImage.src} x="85" y="259" width="150" height="45" preserveAspectRatio="xMidYMid slice" />
    <image href={vybeImage.src} x="253" y="259" width="150" height="45" preserveAspectRatio="xMidYMid slice" />
    <g fill="#edf3f8" font-size="7.4"><text x="93" y="314">Librería 2001</text><text x="261" y="314">Vybe</text></g>
    <g fill="#8be2ef" font-size="5"><text x="225" y="314" text-anchor="end">01</text><text x="395" y="314" text-anchor="end">02</text></g>
  </g>
  <!-- Keep the phone in front of the desktop throughout the reveal. -->
  <g clip-path="url(#reality-mobile-mask)">
    <rect x="367" y="198" width="124" height="220" rx="12" fill="#173147" stroke="#7595a6" stroke-width=".8" />
    <rect x="371" y="202" width="116" height="212" rx="9" fill="#081827" />
    <rect x="380" y="211" width="97.5" height="195" rx="3" fill="#071a2e" />
    <path d="M414 205h30M417 412h24" stroke="#56798c" stroke-width="1.4" stroke-linecap="round" />
    <image href="/logo-light.svg" x="387" y="218" width="51" height="15" />
    <path d="M461 225h9m-9 3h9m-9 3h9" stroke="#b8cbd9" stroke-width=".7" />
    <path d="M380 238h97.5" stroke="#243e53" stroke-width=".5" />
    <g font-size="13.5" font-weight="600" letter-spacing="-.4"><text x="387" y="260" fill="#edf3f8">Diseñar.</text><text x="387" y="276" fill="#8be2ef">Construir.</text></g>
    <text x="387" y="289" font-size="6.2" fill="#b8cbd9">Tu próximo paso.</text>
    <rect x="387" y="299" width="83.5" height="17" rx="2" fill="#8be2ef" />
    <text x="396" y="310" font-size="6.8" font-weight="600" fill="#071a2e">Hablemos</text><path d="m456 308 5-5m-5 0h5v5" stroke="#071a2e" stroke-width=".7" />
    <image href={libraryImage.src} x="387" y="332" width="83.5" height="40" preserveAspectRatio="xMidYMid slice" />
    <text x="387" y="385" font-size="6.4" fill="#edf3f8">Ver proyectos</text><path d="M458 382h11m-4-3 4 3-4 3" stroke="#8be2ef" stroke-width=".7" />
  </g>
</g>
