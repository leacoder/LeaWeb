---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../lib/site';
const english = Astro.url.pathname.startsWith('/en/');
const currentPath = Astro.url.pathname.replace(/^\/en(?=\/)/, '').replace('/404/', '/404.html');
---
<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="/#services">Servicios</a>
      <a href="/#works" aria-current={currentPath.startsWith('/proyectos/') ? 'page' : undefined}>Proyectos</a>
      <a href="/#about">Sobre mí</a>
    </nav>
    <a class="header-contact" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Hablemos <Icon name="external" /></a>
    <div class="language-selector">
      <a data-language={english ? 'es' : 'en'} href={english ? `${currentPath}?lang=es` : `/en${currentPath.replace('/404.html', '/404/')}?lang=en`} lang={english ? 'es' : 'en'} hreflang={english ? 'es' : 'en'} aria-label={english ? 'Cambiar a español' : 'Switch to English'} title={english ? 'Cambiar a español' : 'Switch to English'}>{english ? 'ES' : 'EN'}</a>
    </div>
    <details class="mobile-menu">
      <summary aria-label="Abrir menú de navegación"><span></span><span></span></summary>
      <nav aria-label="Navegación móvil">
        <a href="/#services">Servicios</a><a href="/#works">Proyectos</a><a href="/#about">Sobre mí</a><a href="/#contacts">Contacto</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .language-selector { display: flex; align-items: center; flex-shrink: 0; gap: 2px; font: 12px var(--mono); color: var(--muted); }
  .language-selector a { display: grid; place-items: center; min-width: 44px; min-height: 44px; }
  .language-selector a:hover { color: var(--accent); }
  .language-selector a { border: 1px solid var(--line); }
  @media (max-width: 420px) { :global(.header-contact) { display: none; } .language-selector { margin-left: auto; } }
</style>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
</script>
