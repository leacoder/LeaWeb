        <g class="plan-label plan-titleblock-copy" fill="currentColor"><text x="315" y="451" font-size="6.5" letter-spacing=".7">VISTA RESPONSIVE</text><text x="508" y="451" font-size="6.5" text-anchor="middle">01/02</text><text x="315" y="460" font-size="5.9">LG DESIGN · ESC. 1:4</text><text x="508" y="460" font-size="5.9" text-anchor="middle">REV. A</text></g>
