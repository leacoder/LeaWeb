    </div>
  </div>
  <div class="blueprint-controls" role="group" aria-label="Explorar las vistas del plano" hidden>
    <button type="button" data-plan-view="full" aria-pressed="true" aria-controls="blueprint-drawing">Completo</button>
    <button type="button" data-plan-view="desktop" aria-pressed="false" aria-controls="blueprint-drawing">Escritorio</button>
    <button type="button" data-plan-view="mobile" aria-pressed="false" aria-controls="blueprint-drawing">Móvil</button>
    <span class="blueprint-hint" aria-hidden="true">EXPLORÁ EL PLANO <span>↗</span></span>
  </div>
  <div class="blueprint-bottom" aria-hidden="true"><span><i></i> DEL PLANO A LA REALIDAD</span><span>VISTA RESPONSIVE</span></div>
</div>
<script>
  const drawing = document.querySelector<SVGSVGElement>('#blueprint-drawing');
  const controls = document.querySelector<HTMLElement>('.blueprint-controls');
  if (drawing && controls) {
    const views = {
      full: [0, 0, 560, 480],
      desktop: [22, 44, 425, 345],
      mobile: [345, 177, 175, 267],
    };
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let target = views.full;
    const setView = (view: number[]) => drawing.setAttribute('viewBox', view.join(' '));
    const finish = () => { cancelAnimationFrame(frame); frame = 0; setView(target); };
    controls.querySelectorAll<HTMLButtonElement>('[data-plan-view]').forEach((button) => {
      button.addEventListener('click', () => {
        const name = button.dataset.planView as keyof typeof views;
        if (!(name in views)) return;
        cancelAnimationFrame(frame);
        target = views[name];
        controls.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        if (reducedMotion.matches) { finish(); return; }
        const box = drawing.viewBox.baseVal;
        const start = [box.x, box.y, box.width, box.height];
        const started = performance.now();
        const animate = (now: number) => {
          const progress = Math.min((now - started) / 520, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          setView(start.map((value, index) => value + (target[index] - value) * eased));
          frame = progress < 1 ? requestAnimationFrame(animate) : 0;
        };
        frame = requestAnimationFrame(animate);
      });
    });
    reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) finish(); });
    window.addEventListener('pagehide', finish);
    controls.hidden = false;
  }
</script>
<style>
  .blueprint { -webkit-user-select: none; user-select: none; }
  .blueprint-stage { perspective: 1100px; overflow: hidden; background: #082138; }
  .blueprint-plane { transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transform-origin: 50% 50%; transition: transform 420ms cubic-bezier(.2,.7,.2,1); }
  .blueprint-drawing { width: 100%; height: auto; aspect-ratio: 7 / 6; overflow: hidden; pointer-events: none; }
  .blueprint-controls { display: flex; align-items: center; gap: 3px; padding: 9px 0; border-top: 1px solid var(--line); }
  .blueprint-controls button { min-height: 44px; border: 1px solid transparent; background: transparent; color: var(--muted); padding: 0 12px; font-family: var(--mono); font-size: 10px; transition: color .25s, background .25s, border-color .25s; }
  .blueprint-controls button:hover { color: var(--text); background: rgba(139,226,239,.04); }
  .blueprint-controls button[aria-pressed='true'] { border-color: rgba(139,226,239,.28); background: rgba(139,226,239,.07); color: var(--accent); }
  .blueprint-controls button:focus-visible { outline-offset: -3px; }
  .blueprint-hint { margin-left: auto; padding-right: 8px; color: var(--muted); font-family: var(--mono); font-size: 8px; letter-spacing: .05em; }
  .blueprint-hint > span { color: var(--accent); padding-left: 5px; }
  .plan-reference { opacity: .32; }
  .plan-projection { opacity: .24; }
  .plan-label { font-family: var(--mono, 'IBM Plex Mono'), monospace; fill: currentColor; font-size: 8px; font-weight: 400; letter-spacing: .3px; }
  .plan-paper-label { font-size: 6.8px; letter-spacing: .7px; opacity: .65; }
  .plan-address { font-size: 6.5px; opacity: .75; }
  .plan-webtype { font-family: var(--font, 'Inter Variable'), sans-serif; }
  .plan-small-caps { font-size: 6px; letter-spacing: .5px; opacity: .75; }
  .plan-measurements { opacity: .78; animation: plan-label-in 650ms ease-out 150ms both; }
  .plan-dimension-text { font-size: 9px; opacity: .9; }
  .plan-titleblock { opacity: .5; }
  .plan-titleblock-copy { opacity: .85; }
  .plan-trace { stroke-dasharray: 1; stroke-dashoffset: 0; animation: plan-draw 1.8s cubic-bezier(.22,.65,.3,1) both; }
  .plan-trace-detail { animation-delay: 120ms; }
  .plan-trace-mobile { animation-delay: 220ms; }
  .plan-copy { animation: plan-label-in 700ms ease-out 200ms both; }
  .plan-copy-mobile { animation-delay: 340ms; }
  .plan-scan { opacity: 0; animation: plan-scan 2.8s ease-in-out 550ms both; }
  @keyframes plan-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes plan-label-in { from { opacity: .4; } to { opacity: 1; } }
  @keyframes plan-scan { 0% { opacity: 0; transform: translateY(-4px); } 16% { opacity: .3; } 75% { opacity: .2; } 100% { opacity: 0; transform: translateY(180px); } }
  @media (hover: hover) and (pointer: fine) { .blueprint-plane:hover { will-change: transform; } }
  @media (hover: none), (pointer: coarse) { .blueprint-plane { transform: none; } }
  @media (max-width: 1100px) and (min-width: 851px), (max-width: 420px) { .blueprint-hint { display: none; } .blueprint-controls { justify-content: center; } }
  @media (prefers-reduced-motion: reduce) {
    .blueprint-plane { transform: none; transition: none; }
    .plan-trace, .plan-copy, .plan-measurements, .plan-scan { animation: none; }
    .plan-trace { stroke-dashoffset: 0; }
    .plan-scan { opacity: 0; }
  }
</style>
