          <text x="428.75" y="436" text-anchor="middle" font-size="8">390</text><text x="514" y="307" text-anchor="middle" font-size="8" transform="rotate(-90 514 307)">780</text><text x="520" y="172" text-anchor="middle" font-size="8.3">B</text><text x="69" y="438" font-size="6.5">X</text><text x="42" y="413" font-size="6.5">Y</text>
        </g>
