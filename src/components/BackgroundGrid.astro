<div class="background-grid" data-background-grid aria-hidden="true"></div>

<style is:global>
  body { position: relative; isolation: isolate; }
  .background-grid { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; color: var(--accent); background-image: linear-gradient(rgba(127,189,216,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(127,189,216,.035) 1px, transparent 1px); background-size: 64px 64px; }
  .background-grid svg { position: absolute; left: 0; width: 100%; height: 640px; overflow: hidden; }
  .background-grid path { fill: none; stroke: currentColor; }
  .background-grid .grid-route { opacity: 0; }
  .background-grid .grid-tail { stroke-width: 1.5; stroke-dasharray: 3 20000; }
  .background-grid .grid-point, .background-grid .grid-glow { stroke-linecap: round; stroke-dasharray: .5 20000; }
  .background-grid .grid-point { stroke-width: 2.5; }
  .background-grid .grid-glow { stroke-width: 7; opacity: .18; }
  @media (prefers-reduced-motion: no-preference) {
    .background-grid .grid-route { animation: grid-pulse var(--duration) linear var(--delay) infinite; animation-play-state: paused; }
    .background-grid .grid-route path { animation: grid-travel var(--duration) linear var(--delay) infinite; animation-play-state: paused; }
    .background-grid [data-active] .grid-route, .background-grid [data-active] .grid-route path { animation-play-state: running; }
    @keyframes grid-travel { 0% { stroke-dashoffset: calc(32px + var(--trail-offset, 0px)); } 65%, 100% { stroke-dashoffset: calc(var(--route-end) + var(--trail-offset, 0px)); } }
    @keyframes grid-pulse { 0%, 65%, 100% { opacity: 0; } 6%, 58% { opacity: .56; } }
  }
  @media (max-width: 639px) {
    .background-grid .grid-point { stroke-width: 4; }
    .background-grid .grid-glow { stroke-width: 10; opacity: .28; }
    .background-grid .grid-tail { stroke-width: 2; }
    @media (prefers-reduced-motion: no-preference) {
      .background-grid .grid-route { animation-name: grid-pulse-mobile; }
      .background-grid .grid-route path { animation-name: grid-travel-mobile; }
      @keyframes grid-travel-mobile { 0% { stroke-dashoffset: calc(32px + var(--trail-offset, 0px)); } 85%, 100% { stroke-dashoffset: calc(var(--route-end) + var(--trail-offset, 0px)); } }
      @keyframes grid-pulse-mobile { 0%, 85%, 100% { opacity: 0; } 4%, 80% { opacity: .8; } }
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-background-grid]');
  if (grid && 'ResizeObserver' in window && 'IntersectionObserver' in window) {
    const ns = 'http://www.w3.org/2000/svg';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const visible = new Set<Element>();
    const sync = () => grid.querySelectorAll('svg').forEach((tile) => tile.toggleAttribute('data-active', visible.has(tile) && !document.hidden && !reduced.matches));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({target, isIntersecting}) => isIntersecting ? visible.add(target) : visible.delete(target));
      sync();
    });
    let previousSize = '';
    const updateMasks = () => {
      const origin = grid.getBoundingClientRect();
      const padding = document.body.clientWidth <= 639 ? 12 : 24;
      const protectedElements = Array.from(document.querySelectorAll<HTMLElement>('h1, h2, h3, p, li, dt, dd, a, button, summary, label, figcaption, .eyebrow, .hero-note, .about-intro, .blueprint'));
      const boxes = protectedElements.filter((element) => element.getClientRects().length && !element.closest('[data-background-grid]')).map((element) => {
        const box = element.getBoundingClientRect();
        return { x: box.left - origin.left - padding, y: box.top - origin.top - padding, width: box.width + padding * 2, height: box.height + padding * 2 };
      });
      grid.querySelectorAll<SVGSVGElement>('svg').forEach((tile) => {
        const top = Number.parseFloat(tile.style.top);
        const holes = tile.querySelector('[data-mask-holes]');
        if (!holes) return;
        const fragment = document.createDocumentFragment();
        boxes.filter((box) => box.y < top + 640 && box.y + box.height > top).forEach((box) => {
          const rect = document.createElementNS(ns, 'rect');
          rect.setAttribute('x', String(box.x));
          rect.setAttribute('y', String(box.y - top));
          rect.setAttribute('width', String(box.width));
          rect.setAttribute('height', String(box.height));
          rect.setAttribute('rx', '8');
          fragment.append(rect);
        });
        holes.replaceChildren(fragment);
      });
    };
    const render = () => {
      const width = document.body.clientWidth;
      const mobile = width <= 639;
      const count = Math.ceil(document.body.offsetHeight / 640);
      const size = `${width}:${count}`;
      if (size === previousSize) { updateMasks(); return; }
      previousSize = size;
      observer.disconnect();
      visible.clear();
      grid.replaceChildren();
      for (let i = 0; i < count; i++) {
        const tile = document.createElementNS(ns, 'svg');
        tile.setAttribute('focusable', 'false');
        tile.style.top = `${i * 640}px`;
        const defs = document.createElementNS(ns, 'defs');
        const mask = document.createElementNS(ns, 'mask');
        mask.id = `background-text-mask-${i}`;
        mask.setAttribute('maskUnits', 'userSpaceOnUse');
        mask.setAttribute('x', '0');
        mask.setAttribute('y', '0');
        mask.setAttribute('width', String(width));
        mask.setAttribute('height', '640');
        mask.style.maskType = 'luminance';
        const base = document.createElementNS(ns, 'rect');
        base.setAttribute('width', String(width));
        base.setAttribute('height', '640');
        base.setAttribute('fill', 'white');
        const holes = document.createElementNS(ns, 'g');
        holes.setAttribute('data-mask-holes', '');
        holes.setAttribute('fill', 'black');
        mask.append(base, holes);
        defs.append(mask);
        const routesLayer = document.createElementNS(ns, 'g');
        routesLayer.setAttribute('mask', `url(#${mask.id})`);
        tile.append(defs, routesLayer);
        const firstX = Math.max(64, Math.floor(width * .7 / 64) * 64);
        const secondX = Math.max(64, Math.floor(width * .3 / 64) * 64);
        // Mobile routes stay in the narrow outer gutters, with turns on grid rows.
        // Text masks hide the inward turns wherever content needs the space.
        const routes = mobile ? [
          { path: 'M6 0V512.5H64.5V576.5H6V640', length: 757 },
          { path: `M${width - 6} 640V128.5H${width - 64.5}V64.5H${width - 6}V0`, length: 757 },
          { path: `M0 320.5H${width}`, length: width },
        ] : [
          { path: `M0 128.5H${firstX + .5}V384`, length: firstX + 256 },
          { path: `M${width} 448.5H${secondX + .5}V192`, length: width - secondX + 256 },
          { path: 'M64.5 640V512.5H0', length: 192 },
        ];
        routes.forEach((route, index) => {
          const group = document.createElementNS(ns, 'g');
          group.setAttribute('class', `grid-route${index === 1 ? ' grid-secondary' : ''}`);
          const length = route.length;
          // Keep the head at 38px/s, with a 30px fading wake behind it.
          group.style.setProperty('--duration', `${(length + 32) / (38 * (mobile ? .85 : .65))}s`);
          group.style.setProperty('--route-end', `${-length}px`);
          group.style.setProperty('--delay', `${-i * 5 - index * 12}s`);
          for (let segment = 0; segment < 12; segment++) {
            const kind = segment < 10 ? 'tail' : segment === 10 ? 'glow' : 'point';
            const path = document.createElementNS(ns, 'path');
            path.setAttribute('class', `grid-${kind}`);
            path.setAttribute('d', route.path);
            if (kind === 'tail') {
              path.style.setProperty('--trail-offset', `${(10 - segment) * 3}px`);
              path.style.opacity = String(.025 + (mobile ? .5 : .36) * (segment / 9) ** 2);
            }
            group.append(path);
          }
          routesLayer.append(group);
        });
        grid.append(tile);
        observer.observe(tile);
      }
      updateMasks();
    };
    const resize = new ResizeObserver(render);
    resize.observe(document.body);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    document.addEventListener('toggle', updateMasks, true);
    document.fonts.ready.then(updateMasks);
    window.addEventListener('pagehide', () => { resize.disconnect(); observer.disconnect(); visible.clear(); sync(); });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) { previousSize = ''; resize.observe(document.body); render(); }
    });
    render();
  }
</script>
