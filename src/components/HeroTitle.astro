---
import Icon from './Icon.astro';
const english = Astro.url.pathname.startsWith('/en/');
---
<div class="hero-title-group">
  <h1 id="hero-title" aria-label="Diseñamos tu web, tu app o tu idea.">
    <span class="hero-title-prefix" aria-hidden="true">Diseñamos tu</span>
    <span class="hero-title-line" aria-hidden="true"><span data-hero-word>{english ? 'website' : 'web'}</span><span class="title-period">.</span></span>
  </h1>
  <button class="hero-motion-toggle" type="button" aria-label="Pausar animación del título" aria-pressed="false" hidden>
    <span data-pause-icon><Icon name="pause" /></span><span data-play-icon hidden><Icon name="play" /></span>
  </button>
</div>
<style>
  .hero-title-group { position: relative; }
  .hero-title-group #hero-title { margin: 0; }
  .hero-title-group #hero-title .hero-title-prefix { display: block; color: var(--text); white-space: normal; }
  .hero-title-line { display: block; min-height: 1.15em; padding-inline: 44px; }
  [data-hero-word] { display: inline-block; }
  [data-hero-word] :global(span) { display: inline-block; }
  .hero-motion-toggle { position: absolute; bottom: 0; right: 0; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--muted); }
  .hero-motion-toggle svg { width: 16px; height: 16px; }
  .hero-motion-toggle:hover { color: var(--accent); border-color: var(--accent); }
</style>
<script>
  const word = document.querySelector<HTMLElement>('[data-hero-word]');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-motion-toggle');
  if (word && toggle) {
    const english = document.documentElement.lang.startsWith('en');
    const words = english ? ['website', 'app', 'idea'] : ['web', 'app', 'idea'];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const heading = document.querySelector<HTMLElement>('.hero-title-group')!;
    let index = 0;
    let paused = false;
    let visible = true;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let animations: Animation[] = [];
    const finish = () => { clearTimeout(timer); animations.forEach(animation => animation.cancel()); animations = []; };
    const sync = () => {
      finish();
      toggle.hidden = reduced.matches;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', english ? (paused ? 'Resume title animation' : 'Pause title animation') : (paused ? 'Reanudar animación del título' : 'Pausar animación del título'));
      toggle.querySelector<HTMLElement>('[data-play-icon]')!.hidden = !paused;
      toggle.querySelector<HTMLElement>('[data-pause-icon]')!.hidden = paused;
      if (reduced.matches || paused || !visible || document.hidden) return;
      timer = setTimeout(() => {
        index = (index + 1) % words.length;
        word.replaceChildren(...Array.from(words[index], letter => {
          const span = document.createElement('span');
          span.textContent = letter;
          return span;
        }));
        animations = Array.from(word.children).map((letter, i) => letter.animate([
          { clipPath: 'inset(100% 0 0 0)', transform: 'translateY(.12em)', filter: 'blur(2px)' },
          { clipPath: 'inset(0 0 0 0)', transform: 'translateY(0)', filter: 'blur(0)' },
        ], { duration: 520, delay: i * 65, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'backwards' }));
        // Schedule the next word without canceling this word's entrance.
        timer = setTimeout(sync, 900);
      }, 2600);
    };
    toggle.addEventListener('click', () => { paused = !paused; sync(); });
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); });
    observer.observe(heading);
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('pagehide', finish);
    window.addEventListener('pageshow', sync);
    sync();
  }
</script>
