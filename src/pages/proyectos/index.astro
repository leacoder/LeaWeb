---
import { site } from '../../lib/site';
const english = Astro.url.pathname.startsWith('/en/');
const target = english ? '/en/#works' : '/#works';
---
<!doctype html>
<html lang={english ? 'en' : 'es-AR'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Proyectos | LG Design</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={new URL(target, site.url).href} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <a href={target}>Ver proyectos</a>
    <script is:inline define:vars={{ target }}>
      const destination = new URL(target, location.origin);
      destination.search = location.search;
      location.replace(destination.href);
    </script>
  </body>
</html>
