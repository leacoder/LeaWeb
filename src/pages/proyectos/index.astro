---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';

const projects = (await getCollection('projects', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Proyectos de diseño y desarrollo digital"
  description="Explorá el portfolio de LG Design: Librería 2001 y MatchVybe, dos proyectos con propuestas distintas de diseño y desarrollo digital."
  path="/proyectos/"
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Proyectos', url: '/proyectos/' }]}
>
  <section class="section projects-intro">
    <div class="container">
      <p class="eyebrow">LG Design / Portfolio</p>
      <h1 class="page-title">Ideas que tomaron <span>forma.</span></h1>
      <p class="page-lead text-muted">Una selección de proyectos de diseño y desarrollo digital. Cada uno parte de una necesidad distinta y de una manera propia de conectar con las personas.</p>
      <div class="projects-list">
        {projects.map((project, index) => (
          <a class="project-row" href={`/proyectos/${project.id}/`}>
            <div class="project-image">
              <Image src={project.data.image} alt={project.data.imageAlt} widths={[400, 640, 960]} sizes="(max-width: 700px) 92vw, 48vw" format="webp" quality={80} loading="lazy" />
              <span class="image-corner corner-tl" aria-hidden="true"></span><span class="image-corner corner-br" aria-hidden="true"></span>
            </div>
            <div class="project-copy">
              <p class="eyebrow">{String(index + 1).padStart(2, '0')} / {project.data.sector}</p>
              <h2>{project.data.title}</h2>
              <p class="text-muted">{project.data.description}</p>
              {project.data.historical && <span class="project-tag">Archivo de proyectos</span>}
              <span class="project-link">Ver proyecto <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section next-step">
    <div class="container next-step-inner">
      <div><p class="eyebrow">El próximo proyecto</p><h2 class="detail-heading">Puede ser el tuyo.</h2><p class="text-muted">Contame qué querés construir o qué necesita tu proyecto para avanzar.</p></div>
      <a class="button button-primary" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Contame tu proyecto <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-intro { padding-top: clamp(4rem, 9vw, 8rem); }
  .page-title { font-size: clamp(2.6rem, 6.5vw, 5.5rem); letter-spacing: -.055em; line-height: 1.1; font-weight: 500; max-width: 15ch; }
  .page-title span { color: #8be2ef; }
  .detail-heading { font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.15; letter-spacing: -.045em; margin: 0 0 1rem; }
  .page-lead { max-width: 59ch; font-size: 1.125rem; line-height: 1.8; margin: 1.75rem 0 0; }
  .projects-list { margin-top: clamp(3rem, 6vw, 6rem); border-top: 1px solid rgba(155,196,221,.2); }
  .project-row { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding: clamp(2rem, 5vw, 4rem) 0; color: inherit; text-decoration: none; border-bottom: 1px solid rgba(155,196,221,.2); }
  .project-image { position: relative; background: #102638; padding: clamp(.75rem, 1.6vw, 1.25rem); aspect-ratio: 4/3; display: grid; place-items: center; min-width: 0; }
  .project-image :global(img) { display: block; width: 100%; height: 100%; max-height: 100%; object-fit: contain; }
  .image-corner { position: absolute; width: 14px; height: 14px; border-color: #8be2ef; border-style: solid; pointer-events: none; }
  .corner-tl { top: 0; left: 0; border-width: 1px 0 0 1px; }
  .corner-br { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  .project-copy h2 { margin: .9rem 0 1rem; font-weight: 500; font-size: clamp(1.8rem, 3.4vw, 3rem); letter-spacing: -.04em; }
  .project-copy > p:not(.eyebrow) { line-height: 1.8; max-width: 45ch; }
  .project-tag { display: block; width: fit-content; border: 1px solid rgba(155,196,221,.2); color: #a3b5c4; padding: .4rem .6rem; font-family: var(--font-mono, monospace); font-size: .7rem; margin-top: 1.4rem; }
  .project-link { display: inline-flex; gap: .75rem; color: #8be2ef; margin-top: 1.75rem; font-size: .875rem; }
  .project-link > span { transition: transform .2s; }
  .project-row:hover .project-link > span { transform: translate(3px, -3px); }
  .next-step { border-top: 1px solid rgba(155,196,221,.2); }
  .next-step-inner { display: flex; justify-content: space-between; gap: 2rem; align-items: center; }
  .next-step-inner p { line-height: 1.7; }
  .next-step-inner .button { flex-shrink: 0; }
  @media (max-width: 700px) { .project-row { grid-template-columns: 1fr; gap: 1.75rem; } .project-image { aspect-ratio: 4/3; } .next-step-inner { flex-direction: column; align-items: flex-start; } }
  @media (prefers-reduced-motion: reduce) { .project-link > span { transition: none; } }
</style>
