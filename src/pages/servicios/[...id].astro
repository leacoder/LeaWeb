---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

interface Props { service: CollectionEntry<'services'>; }
const { service } = Astro.props;
const { Content } = await render(service);
const otherServices = (await getCollection('services')).filter((entry) => entry.id !== service.id).sort((a, b) => a.data.number.localeCompare(b.data.number, 'es', { numeric: true }));
---

<BaseLayout
  title={service.data.title}
  description={service.data.description}
  path={`/servicios/${service.id}/`}
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Servicios', url: '/servicios/' }, { name: service.data.shortTitle, url: `/servicios/${service.id}/` }]}
>
  <section class="section service-hero">
    <div class="container">
      <p class="eyebrow">Servicio {service.data.number} / LG Design</p>
      <h1 class="detail-title">{service.data.title}</h1>
      <p class="detail-lead text-muted">{service.data.description}</p>
      <a class="button button-primary" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Contame tu proyecto <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section service-body">
    <div class="container service-body-grid">
      <article class="prose"><Content /></article>
      <aside class="deliverables" aria-labelledby="deliverables-title">
        <p class="eyebrow">Plan de trabajo</p>
        <h2 id="deliverables-title">Qué podemos construir</h2>
        <ul>{service.data.deliverables.map((item) => <li><span aria-hidden="true">+</span>{item}</li>)}</ul>
        <p class="text-muted">Definimos el alcance y las prioridades a partir de las necesidades de tu proyecto.</p>
      </aside>
    </div>
  </section>
  <section class="section related-services">
    <div class="container">
      <p class="eyebrow">Otras posibilidades</p>
      <h2 class="detail-heading">Cada proyecto tiene su camino.</h2>
      <div class="related-list">{otherServices.map((entry) => <a href={`/servicios/${entry.id}/`}><span>{entry.data.shortTitle}</span><span aria-hidden="true">↗</span></a>)}</div>
      <a class="button button-secondary" href="/proyectos/">Ver proyectos <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero { padding-top: clamp(3rem, 7vw, 6rem); border-bottom: 1px solid rgba(155,196,221,.2); }
  .detail-title { max-width: 18ch; font-size: clamp(2.4rem, 6.5vw, 5.5rem); letter-spacing: -.055em; line-height: 1.1; font-weight: 500; }
  .detail-lead { max-width: 56ch; font-size: 1.15rem; line-height: 1.8; margin: 1.75rem 0 2rem; }
  .detail-heading { font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.15; letter-spacing: -.045em; margin: 0 0 1rem; }
  .service-body-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr); gap: clamp(2.5rem, 6vw, 7rem); align-items: start; }
  .prose { max-width: 68ch; overflow-wrap: anywhere; }
  .prose :global(h2) { font-size: clamp(1.5rem, 2.8vw, 2rem); letter-spacing: -.03em; font-weight: 500; margin: 2.5rem 0 1rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin: 2rem 0 .75rem; font-weight: 500; font-size: 1.2rem; }
  .prose :global(p), .prose :global(li) { color: #a3b5c4; line-height: 1.85; }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25rem; }
  .prose :global(a) { color: #8be2ef; text-underline-offset: .25em; }
  .prose :global(strong) { color: #eaf3f8; font-weight: 600; }
  .deliverables { padding: clamp(1.5rem, 3vw, 2.5rem); background: rgba(93,161,203,.05); border: 1px solid rgba(155,196,221,.2); }
  .deliverables h2 { font-size: 1.5rem; line-height: 1.3; letter-spacing: -.025em; font-weight: 500; }
  .deliverables ul { list-style: none; padding: 0; margin: 1.75rem 0; }
  .deliverables li { display: flex; gap: .875rem; padding: .8rem 0; border-bottom: 1px solid rgba(155,196,221,.15); line-height: 1.55; }
  .deliverables li span { color: #8be2ef; flex-shrink: 0; font-family: var(--font-mono, monospace); }
  .deliverables > p:last-child { font-size: .875rem; line-height: 1.7; }
  .related-services { border-top: 1px solid rgba(155,196,221,.2); }
  .related-list { margin: 2.5rem 0; border-top: 1px solid rgba(155,196,221,.2); }
  .related-list a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.4rem 0; color: inherit; text-decoration: none; border-bottom: 1px solid rgba(155,196,221,.2); font-size: clamp(1.2rem, 2.5vw, 1.65rem); }
  .related-list a > span:last-child { color: #8be2ef; }
  @media (max-width: 800px) { .service-body-grid { grid-template-columns: 1fr; } .deliverables { max-width: 40rem; } }
  @media (max-width: 359px) { .detail-title { font-size: 2rem; } }
</style>
