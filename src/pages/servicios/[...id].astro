---
import Icon from '../../components/Icon.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

interface Props { service: CollectionEntry<'services'>; }
const { service } = Astro.props;
const { Content } = await render(service);
const otherServices = (await getCollection('services')).filter((entry) => entry.id !== service.id).sort((a, b) => a.data.number.localeCompare(b.data.number, 'es', { numeric: true }));
---

<BaseLayout
  title={service.data.title}
  description={service.data.description}
  path={`/servicios/${service.id}/`}
  structuredData={[{ '@type': 'Service', '@id': `${site.url}/servicios/${service.id}/#service`, name: service.data.title, serviceType: service.data.shortTitle, description: service.data.description, url: `${site.url}/servicios/${service.id}/`, provider: { '@id': `${site.url}/#organization` }, areaServed: { '@type': 'Country', name: 'Argentina' }, mainEntityOfPage: { '@id': `${site.url}/servicios/${service.id}/#webpage` } }]}
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Servicios', url: '/servicios/' }, { name: service.data.shortTitle, url: `/servicios/${service.id}/` }]}
>
  <section class="section service-hero" aria-labelledby="service-title">
    <div class="container service-columns">
      <div class="service-intro">
        <h1 id="service-title">{service.data.shortTitle}</h1>
        <p class="service-lead">{service.data.lead}</p>
        <a class="button button-primary" href="#contacts">Contame tu proyecto <Icon name="arrow" /></a>
      </div>
      <div class="deliverables" aria-labelledby="deliverables-title">
        <h2 id="deliverables-title">Qué incluye</h2>
        <ul>{service.data.deliverables.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}</ul>
      </div>
    </div>
  </section>
  <section class="section service-body">
    <div class="container service-columns">
      <article class="prose"><Content /></article>
      <div class="service-faq" aria-labelledby="service-faq-title">
        <h2 id="service-faq-title">Preguntas frecuentes</h2>
        {service.data.faqs.map(faq => <details class="faq-item" name="service-faq"><summary>{faq.question}<span class="faq-indicator" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}
      </div>
    </div>
  </section>
  <nav class="related-services container" aria-label="Otros servicios">
    <h2>Otros servicios</h2>
    <div class="related-list">{otherServices.map((entry) => <a class="text-link" href={`/servicios/${entry.id}/`}><span>{entry.data.shortTitle}</span><Icon name="arrow" /></a>)}</div>
  </nav>
</BaseLayout>

<style>
  .service-columns { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .service-hero { padding-block: clamp(40px, 5vw, 64px); }
  .service-intro h1 { max-width: 17ch; font-size: clamp(36px, 4.6vw, 64px); letter-spacing: -.04em; line-height: 1.12; overflow-wrap: normal; }
  .service-lead { max-width: 48ch; font-size: 17px; line-height: 1.7; margin-block: 24px 32px; text-wrap: pretty; }
  .deliverables h2, .service-faq h2 { font-size: 24px; letter-spacing: -.025em; line-height: 1.3; margin-bottom: 20px; }
  .deliverables ul { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .deliverables li { display: flex; align-items: center; gap: 12px; padding-block: 16px; border-bottom: 1px solid var(--line); line-height: 1.5; }
  .deliverables :global(svg) { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
  .service-body { padding-block: 48px; border-top: 1px solid var(--line); }
  .prose { min-width: 0; font-size: 16px; line-height: 1.7; }
  .prose :global(h2) { font-size: 24px; letter-spacing: -.025em; line-height: 1.3; margin: 32px 0 16px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(ol) { margin: 0 0 16px; }
  .prose :global(li) { margin-block: 8px; padding-left: 4px; }
  .prose :global(li::marker) { color: var(--accent); }
  .service-faq { min-width: 0; }
  .service-faq .faq-item:first-of-type { border-top: 1px solid var(--line); }
  .service-faq .faq-item summary { min-height: 64px; padding-block: 18px; gap: 20px; line-height: 1.5; }
  .service-faq .faq-item p { padding: 0 0 20px; font-size: 15px; line-height: 1.7; }
  .faq-indicator { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .faq-indicator::before, .faq-indicator::after { content: ''; position: absolute; background: currentColor; inset: 6px 1px; }
  .faq-indicator::after { transform: rotate(90deg); }
  .related-services { padding-block: 16px 56px; }
  .related-services h2 { font-size: 18px; letter-spacing: -.02em; margin-bottom: 8px; }
  .related-list { display: flex; flex-wrap: wrap; gap: 8px 40px; }
  .related-list a { gap: 24px; }
  @media (max-width: 760px) {
    .service-columns { grid-template-columns: 1fr; gap: 40px; }
    .service-intro h1 { max-width: 20ch; }
    .service-hero { padding-block: 32px 40px; }
    .service-body { padding-block: 40px; }
    .related-services { padding-block: 0 40px; }
    .related-list { display: grid; gap: 0; }
    .related-list a { width: 100%; }
  }
</style>
<script>
  const questions = Array.from(document.querySelectorAll<HTMLDetailsElement>('.service-faq .faq-item'));
  questions.forEach(question => question.addEventListener('toggle', () => {
    if (question.open) questions.forEach(other => { if (other !== question) other.open = false; });
  }));
</script>
