---
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site';

const services = (await getCollection('services')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number, 'es', { numeric: true })
);
---

<BaseLayout
  title="Servicios de diseño y desarrollo digital"
  description="Diseño y desarrollo web, sistemas e integraciones y mejora de proyectos existentes. Consultoría de Leandro García para PyMEs y emprendedores de Argentina."
  path="/servicios/"
  compactFooter
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Servicios', url: '/servicios/' }]}
>
  <section class="section services-intro" aria-labelledby="services-title">
    <div class="container">
      <h1 id="services-title" class="page-title">Diseño y desarrollo digital.</h1>
      <p class="page-lead text-muted">Creo sitios, conecto herramientas y mejoro proyectos.</p>
      <div class="services-list">
        {services.map((service) => (
          <a class="service-row" href={`/servicios/${service.id}/`}>
            <h2>{service.data.shortTitle}</h2>
            <p class="text-muted">{service.data.summary}</p>
            <Icon name="external" class="service-arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section id="contacts" class="section next-step" aria-labelledby="next-step-title">
    <div class="container next-step-inner">
      <h2 id="next-step-title" class="detail-heading">¿Tenés un proyecto en mente?</h2>
      <a class="button button-primary" href={site.whatsapp} data-contact="whatsapp" target="_blank" rel="noopener noreferrer">Hablemos <Icon name="external" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-intro { padding-block: clamp(2.5rem, 4vw, 3.5rem) 0; }
  .page-title { font-size: clamp(2.25rem, 4.5vw, 3.75rem); font-weight: 500; letter-spacing: -.04em; line-height: 1.12; }
  .page-lead { max-width: 60ch; font-size: 1.0625rem; line-height: 1.6; margin-top: 1rem; }
  .services-list { margin-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--line); }
  .service-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 1.5rem; align-items: center; gap: 2rem; padding-block: 2rem; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .service-row h2 { margin: 0; font-size: clamp(1.375rem, 2.2vw, 1.875rem); line-height: 1.25; letter-spacing: -.03em; font-weight: 500; }
  .service-row p { max-width: 42ch; line-height: 1.6; margin: 0; }
  .service-row :global(.service-arrow) { width: 1.5rem; height: 1.5rem; color: var(--accent); transition: transform .2s; }
  .service-row:hover h2, .service-row:focus-visible h2 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .service-row:hover :global(.service-arrow), .service-row:focus-visible :global(.service-arrow) { transform: translate(3px, -3px); }
  .next-step { padding-block: 2.5rem clamp(3rem, 5vw, 4rem); }
  .next-step-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .detail-heading { font-size: clamp(1.375rem, 2.4vw, 1.875rem); line-height: 1.25; letter-spacing: -.03em; margin: 0; }
  .next-step-inner .button { flex-shrink: 0; }
  :global(body:has(.services-intro) .background-grid-lines) { opacity: .4; }
  :global(body:has(.services-intro) .background-grid) { opacity: .3; }
  @media (max-width: 640px) {
    .service-row { grid-template-columns: minmax(0, 1fr) 1.5rem; gap: .625rem 1rem; padding-block: 1.5rem; }
    .service-row h2 { grid-column: 1; grid-row: 1; }
    .service-row p { grid-column: 1; grid-row: 2; font-size: .9375rem; }
    .service-row :global(.service-arrow) { grid-column: 2; grid-row: 1; }
    .next-step-inner { align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .service-row :global(.service-arrow) { transition: none; transform: none; } }
</style>
