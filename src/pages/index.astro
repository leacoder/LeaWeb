---
import SentenceText from '../components/SentenceText.astro';
import SectionJourney from '../components/SectionJourney.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blueprint from '../components/Blueprint.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import ProjectPreview from '../components/ProjectPreview.astro';
import { site } from '../lib/site';
const services = (await getCollection('services')).sort((a, b) => a.data.number.localeCompare(b.data.number));
const projects = (await getCollection('projects', ({ data }) => data.published)).filter((entry) => entry.data.featured).sort((a, b) => a.data.order - b.data.order);
const steps = [
  { number: '01', title: 'Entender', description: 'Tu idea, tu negocio y el punto de partida. Primero, las preguntas correctas.' },
  { number: '02', title: 'Definir', description: 'Un alcance claro, prioridades y un plan que tenga sentido para tu proyecto.' },
  { number: '03', title: 'Construir', description: 'Diseño y desarrollo con avances visibles. Decisiones que tomamos juntos.' },
  { number: '04', title: 'Entregar', description: 'Pruebas, puesta en marcha y una base clara para que puedas seguir creciendo.' },
];
const faqs = [
  { question: '¿Qué es LG Design y quién realiza el trabajo?', answer: 'LG Design es la marca de Leandro García, consultor, diseñador y desarrollador de soluciones digitales. Trabajo de forma remota con PyMEs y emprendedores de Argentina para crear webs, desarrollar sistemas e integraciones o mejorar y completar proyectos existentes.' },
  { question: '¿Podés sumarte a un proyecto que ya empezó?', answer: 'Sí, primero reviso el estado del proyecto y lo que necesitás resolver. A partir de ese diagnóstico definimos qué conviene mantener, mejorar o completar, y acordamos el alcance antes de avanzar.' },
  { question: '¿Trabajás con clientes de toda Argentina?', answer: 'Sí, trabajo de forma remota. Podemos coordinar reuniones, revisar avances y compartir el material del proyecto sin importar dónde esté tu negocio.' },
  { question: '¿Cómo se define el presupuesto?', answer: 'Depende del alcance y del punto de partida. Después de entender la necesidad, preparo una propuesta con entregables, etapas y condiciones. Si el proyecto es grande, podemos organizarlo por fases.' },
  { question: '¿Qué necesitás para empezar?', answer: 'Una conversación sobre qué querés lograr. Si ya tenés una web, un sistema, diseños o documentación, ese material ayuda. Si solo tenés una idea, podemos empezar por darle forma.' },
];
---
<BaseLayout title="Diseño web y desarrollo de sistemas para PyMEs en Argentina" description={site.description} socialTitle="LG Design · Diseño y desarrollo digital" socialDescription="Webs, sistemas e integraciones. Creá tu proyecto o hacé avanzar uno que ya empezó." structuredData={[{ '@type': 'FAQPage', '@id': `${site.url}/#faq`, url: `${site.url}/`, inLanguage: 'es-AR', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }]}>
  <section class="hero container" id="home" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-cross">+</span> DISEÑO, DESARROLLO Y CRITERIO</p>
      <h1 id="hero-title">Diseño y desarrollo digital para <span>hacer avanzar</span> tu proyecto<span class="title-period">.</span></h1>
      <p class="hero-description">Webs, sistemas e integraciones para PyMEs y emprendedores.<br />Desde una idea en papel hasta ese proyecto que necesita el próximo paso.</p>
      <div class="hero-actions"><a class="button button-primary" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-contact="whatsapp">Contame tu proyecto <Icon name="external" /></a><a class="button button-secondary" href="/#works">Ver proyectos <Icon name="arrow" /></a></div>
      <div class="hero-note"><span class="status-dot"></span> Leandro García · Consultor digital · Argentina</div>
    </div>
    <Blueprint />
    <div class="hero-bottom"><span>IDEAS CLARAS. SOLUCIONES CONCRETAS.</span><a href="#services">EXPLORÁ LO QUE PODEMOS HACER <span>↓</span></a></div>
  </section>

  <section class="services-section section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">01 / QUÉ PUEDO HACER POR VOS</p><h2 id="services-title">Una idea. Muchas piezas.<br /><span>Una solución que funciona.</span></h2></div><p class="section-intro">Diseño y tecnología con un mismo objetivo: resolver lo que tu negocio necesita.</p></div>
      <div class="service-grid">{services.map((service) => <a class="service-card" href={`/servicios/${service.id}/`}><div class="service-card-top"><Icon name={service.data.icon} /><span class="mono">{service.data.number}</span></div><h3>{service.data.shortTitle}</h3><p><SentenceText text={service.data.description} /></p><span class="service-card-link">{service.data.ctaLabel} <Icon name="arrow" /></span></a>)}</div>
    </div>
  </section>

  <section class="projects-section section container" id="works" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow">02 / DEL PLANO A LA REALIDAD</p><h2 id="projects-title">Ideas que tomaron <span>forma.</span></h2></div><a class="text-link" href="/proyectos/">Todos los proyectos <Icon name="arrow" /></a></div>
    <div class="featured-projects">{projects.map((project, index) => <a class="featured-project" href={`/proyectos/${project.id}/`}><div class="project-image"><span class="project-corner corner-tl" aria-hidden="true"></span><span class="project-corner corner-tr" aria-hidden="true"></span><span class="project-corner corner-bl" aria-hidden="true"></span><span class="project-corner corner-br" aria-hidden="true"></span><div class="project-image-label"><span>PROYECTO / {String(index + 1).padStart(2, '0')}</span><span>{project.data.historical ? 'ARCHIVO / WEB' : 'PRODUCTO DIGITAL'}</span></div><ProjectPreview project={project} /></div><div class="project-info"><div><p class="project-sector">{project.data.sector}</p><h3>{project.data.title}</h3><p class="project-description"><SentenceText text={project.data.description} /></p><span class="project-case-link">Explorar proyecto <Icon name="arrow" /></span></div><span class="project-arrow" aria-hidden="true"><Icon name="external" /></span></div></a>)}</div>
    <p class="portfolio-note">De una presencia web para un comercio a una plataforma para conectar personas. Dos proyectos, distintas necesidades.</p>
  </section>

  <section class="process-section section" id="process" aria-labelledby="process-title">
    <div class="container"><div class="section-heading"><div><p class="eyebrow">03 / CÓMO TRABAJO</p><h2 id="process-title">Un buen proyecto<br />necesita un buen <span>plan.</span></h2></div><p class="section-intro">Sin perder de vista la idea original.<br />Sin dejar los detalles al azar.</p></div><div class="process-grid">{steps.map((step) => <div class="process-step"><div class="step-number">{step.number}<span class="step-cross">+</span></div><h3>{step.title}</h3><p><SentenceText text={step.description} /></p></div>)}</div></div>
  </section>

  <section class="about-section section container" id="about" aria-labelledby="about-title">
    <div class="about-intro">
      <div class="about-plan-meta" aria-hidden="true"><span>LG / PERFIL</span><span>PLANO 04</span></div>
      <div class="about-plan-sheet">
        <svg class="about-plan-guides" viewBox="0 0 480 400" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <g stroke="currentColor" stroke-width=".7" opacity=".45">
            <path d="M24 44V20h432v24M24 30h432M20 26l8 8m424-8 8 8M24 62V358M456 62V358" />
            <path d="M16 62h16m-8-8v16M448 62h16m-8-8v16M16 358h16m-8-8v16M448 358h16m-8-8v16" />
            <path d="M24 86h432M24 324h432" stroke-dasharray="3 7" opacity=".4" />
          </g>
          <g stroke="currentColor" opacity=".2">
            <circle cx="413" cy="292" r="28"/><circle cx="413" cy="292" r="43" stroke-dasharray="2 5"/>
            <path d="M362 292h102M413 241v102m-10-41 20-20" stroke-width=".7"/>
          </g>
        </svg>
        <div class="about-plan-content">
          <p class="eyebrow">04 / SOBRE MÍ</p>
          <h2 id="about-title"><span>Soy Leandro</span> <span>García.</span></h2>
          <p class="about-subtitle">Ingeniería, diseño y desarrollo.</p>
        </div>
        <div class="about-plan-legend" aria-hidden="true"><span>01 / CRITERIO</span><span>02 / DISEÑO</span><span>03 / DESARROLLO</span></div>
      </div>
      <div class="about-plan-footer" aria-hidden="true"><span>DE LA IDEA A LA SOLUCIÓN</span><span class="about-plan-mark">+</span></div>
    </div>
    <div class="about-copy">
      <p class="about-credential">Ingeniero en Sistemas · <abbr title="Universidad Tecnológica Nacional">UTN</abbr></p>
      <p>Desarrollo aplicaciones y sistemas a medida<span class="about-web-line"> y diseño sitios web.</span><br />Combino ingeniería y diseño para crear productos que funcionen bien y sean fáciles de usar.</p>
      <p>Trabajo desde el análisis hasta la puesta en marcha.<br />Puedo construir una idea desde cero o sumarme a un producto existente para mejorarlo.</p>
      <a class="text-link" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-contact="whatsapp">Contame qué tenés en mente <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="faq-section section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div><p class="eyebrow">05 / ANTES DE EMPEZAR</p><h2 id="faq-title">Las primeras<br /><span>preguntas.</span></h2><p class="faq-intro">Cada proyecto es distinto.<br />Estas respuestas ayudan a dar el primer paso.</p></div><div class="faq-list">{faqs.map((faq) => <details class="faq-item"><summary>{faq.question}<span aria-hidden="true">+</span></summary><p><SentenceText text={faq.answer} /></p></details>)}</div></div></section>
  <SectionJourney />
</BaseLayout>
