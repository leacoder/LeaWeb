---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import { Image } from 'astro:assets';
import library from '../../assets/projects/libreria2001.jpg';
import vybe from '../../assets/projects/matchvybe.png';
import vybeLogin from '../../assets/projects/vybe-login.png';
import vybeEvents from '../../assets/projects/vybe-events.png';
import Logo from '../../components/Logo.astro';
import LanguagePreference from '../../components/LanguagePreference.astro';
import { site } from '../../lib/site';
import '../../styles/v2.css';
const english = Astro.url.pathname.startsWith('/en/');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <LanguagePreference />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071a2e" />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="Diseño web, sistemas a medida e integraciones para PyMEs y emprendedores de Argentina. Leandro García: de tu idea a una solución en funcionamiento." />
    <title>Diseño web y sistemas a medida para PyMEs · LG Design</title>
    <link rel="canonical" href={`https://lgdesign.com.ar${english ? '/en' : ''}/v2/`} />
    <link rel="alternate" hreflang="es" href="https://lgdesign.com.ar/v2/" />
    <link rel="alternate" hreflang="en" href="https://lgdesign.com.ar/en/v2/" />
    <link rel="alternate" hreflang="x-default" href="https://lgdesign.com.ar/v2/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="v2">
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="nav">
      <Logo />
      <nav aria-label="Navegación principal"><a href="#piezas">Servicios</a><a href="#proyectos">Proyectos</a><a href="#criterio">Cómo trabajo</a><a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a><a class="language-toggle" data-language={english ? 'es' : 'en'} href={english ? '/v2/?lang=es' : '/en/v2/?lang=en'} lang={english ? 'es' : 'en'} hreflang={english ? 'es' : 'en'} aria-label={english ? 'Cambiar a español' : 'Switch to English'}>{english ? 'ES' : 'EN'}</a></nav>
    </header>
    <main id="main">
      <div class="story" id="recorrido">
        <div class="scene" aria-hidden="true">
          <div class="scene-inner">
            <div class="ruler"><span>LG / MESA DE TRABAJO</span><span data-scene-label>IDEA → ESTRUCTURA</span></div>
            <div class="drawing-space">
              <div class="axis axis-h"></div><div class="axis axis-v"></div>
              <div class="dimension dimension-top">DISEÑO + INGENIERÍA</div>
              <div class="screen">
                <div class="screen-bar"><span></span><span></span><span></span><i data-domain>Un proyecto empieza a tomar forma</i></div>
                <div class="screen-content">
                  <svg class="wireframe" viewBox="0 0 1000 660" fill="none">
                    <defs><pattern id="v2-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" stroke="currentColor" stroke-width=".5" opacity=".18" /></pattern></defs>
                    <rect width="1000" height="660" fill="url(#v2-grid)" />
                    <g class="draw-lines" stroke="currentColor" stroke-width="1.5">
                      <path d="M40 90H960M40 40H150V65H40ZM610 48H675M720 48H785M835 36H955V72H835Z" />
                      <path d="M60 175H440M60 195H440M60 240H385M60 260H385M60 320H415M60 340H345M60 402H220V450H60Z" />
                      <path d="M520 145H940V480H520ZM520 145L940 480M940 145L520 480" />
                      <path d="M60 550H320V620H60ZM370 550H630V620H370ZM680 550H940V620H680Z" />
                    </g>
                    <g class="guides" stroke="currentColor" stroke-width="1" stroke-dasharray="5 8" opacity=".35"><path d="M40 0V660M500 0V660M960 0V660M0 120H1000M0 510H1000" /></g>
                    <g fill="currentColor" font-family="monospace" font-size="13"><text x="60" y="150">UNA IDEA</text><text x="650" y="326">MUCHAS POSIBILIDADES</text><text x="60" y="647">ESTRUCTURA / VISTA ESCRITORIO</text></g>
                  </svg>
                  <div class="web-parts">
                    <div class="web-part part-nav"><small>NAVEGACIÓN</small><strong>Tu marca.</strong><span>Inicio &nbsp; Proyecto &nbsp; Contacto</span></div>
                    <div class="web-part part-copy"><small>CONTENIDO</small><strong>Una web que<br />habla de vos.</strong><p>Tu idea, con una identidad propia.</p><span class="part-cta">Conocé el proyecto <b>↗</b></span></div>
                    <div class="web-part part-image part-services"><small>SERVICIOS</small><strong>Lo que hacemos por vos.</strong><span>Diseño web <b>↗</b></span><span>Sistemas a medida <b>↗</b></span><span>Integraciones <b>↗</b></span></div>
                    <div class="web-part part-form"><small>INTERACCIÓN</small><strong>Empecemos a conversar.</strong><span>Tu email <b>Enviar ↗</b></span></div>
                    <div class="web-part part-footer"><small>CONEXIONES</small><span>Tu marca. <i>Contacto / Redes / Ubicación</i></span></div>
                  </div>
                  <Image class="real real-library" src={library} width={1200} alt="" loading="eager" />
                  <Image class="real real-vybe" src={vybe} width={1200} alt="" loading="eager" />
                  <div class="vybe-access"><Image src={vybeLogin} width={1200} alt="" /><span class="demo-cursor"><svg viewBox="0 0 24 30" fill="none"><path d="M2 2L21 18L12 19L8 27L2 2Z" fill="white" stroke="#101826" stroke-width="1.5" /></svg></span></div>
                  <div class="vybe-arrival"><strong>Vy<span>be</span></strong><span>Conectá con tu próximo plan.</span></div>
                  <div class="vybe-events"><Image src={vybeEvents} width={1200} alt="" /></div>
                  <div class="reveal-line"></div>
                </div>
              </div>
              <span class="annotation annotation-a">Cada pieza tiene un propósito.</span>
              <span class="annotation annotation-b">Del plano a la realidad.</span>
            </div>
            <div class="scene-footer"><span data-stage>01 / EL PUNTO DE PARTIDA</span><div class="progress"><span></span></div><span>LG</span></div>
          </div>
        </div>
        <div class="chapters">
          <section class="chapter intro" data-step="0">
            <h1>Diseño web y sistemas<br /><em>para tu negocio.</em></h1>
            <p class="lead">De la idea a una solución que funciona.</p>
            <p>Creo sitios web, sistemas a medida e integraciones para PyMEs y emprendedores. Desde Argentina, de forma remota.</p>
            <a class="button" href="#contacto">Contame tu proyecto <span aria-hidden="true">↗</span></a>
            <div class="signature"><span></span> Leandro García · Ingeniería + diseño</div>
            <a class="scroll-note" href="#piezas">Bajá y mirá cómo toma forma <span aria-hidden="true">↓</span></a>
          </section>
          <section class="chapter pieces" id="piezas" data-step="1">
            <h2>Una idea.<br />Las piezas <em>correctas.</em></h2>
            <p>Diseño claro por fuera. Las herramientas que necesitás por dentro.</p>
            <div class="services">
              <a href="/servicios/diseno-desarrollo-web/"><h3>Diseño y desarrollo web <span aria-hidden="true">↗</span></h3><p>Mostrá lo que hacés y facilitá las consultas desde cualquier dispositivo.</p></a>
              <a href="/servicios/sistemas-integraciones/"><h3>Sistemas a medida e integraciones <span aria-hidden="true">↗</span></h3><p>Conectá tus herramientas y simplificá las tareas de tu negocio.</p></a>
              <a href="/servicios/mejora-proyectos/"><h3>Mejora de proyectos existentes <span aria-hidden="true">↗</span></h3><p>Corregí problemas, sumá funciones o completá lo que ya empezaste.</p></a>
            </div>
          </section>
          <section class="chapter project" id="proyectos" data-step="2">
            <h2>El plano se vuelve <em>realidad.</em></h2>
            <h3>Librería 2001</h3>
            <span class="project-kind">Comercio y servicios</span>
            <p>Una librería de Avellaneda, con su identidad y sus productos, convertida en una experiencia digital.</p>
            <p class="project-detail">Diseñé y desarrollé el sitio, su catálogo y las consultas por WhatsApp. También resolví la publicación y el hosting.</p>
            <a class="text-link" href="/proyectos/libreria-2001/">Explorar Librería 2001 <span aria-hidden="true">↗</span></a>
            <Image class="fallback-project" src={library} width={800} alt="Portada real de Librería 2001, con su catálogo y materiales de artística" />
          </section>
          <section class="chapter project" data-step="3" id="vybe">
            <h2>O se convierte<br />en una <em>conexión.</em></h2>
            <h3>Vybe</h3>
            <span class="project-kind">Eventos y comunidades</span>
            <p>Una idea propia: conectar personas que comparten eventos, comunidades y lugares.</p>
            <p class="project-detail">De la idea a la app web. Diseño, desarrollo, perfiles, base de datos y chat: las piezas de un mismo producto.</p>
            <a class="text-link" href="/proyectos/matchvybe/">Explorar Vybe <span aria-hidden="true">↗</span></a>
            <p class="demo-description">Demo: portada, acceso y eventos. Transición recreada, sin datos de la cuenta.</p>
            <button class="replay" type="button" data-replay>Volver a ver la transición <span aria-hidden="true">↻</span></button>
            <Image class="fallback-project" src={vybe} width={800} alt="Portada real de Vybe con eventos y su propuesta para conectar personas" />
          </section>
        </div>
      </div>
      <section class="criteria wrap" id="criterio">
        <div class="criteria-title"><h2>Detrás de cada línea,<br /><em>una decisión.</em></h2><p>Un buen proyecto necesita un buen plan.<br />Y alguien que lo acompañe hasta el final.</p></div>
        <ol class="process">
          <li><span>01</span><h3>Entender</h3><p>Tu negocio, las personas que lo usan y lo que necesitás resolver.</p></li>
          <li><span>02</span><h3>Definir</h3><p>Un alcance claro. Prioridades y decisiones que tomamos juntos.</p></li>
          <li><span>03</span><h3>Construir</h3><p>Diseño y desarrollo con avances visibles y tu devolución.</p></li>
          <li><span>04</span><h3>Entregar</h3><p>Pruebas, puesta en marcha y una base para seguir creciendo.</p></li>
        </ol>
      </section>
      <section class="about wrap" id="leandro"><div class="personal-mark" aria-hidden="true">LG<span>DISEÑO + INGENIERÍA</span></div><div><h2>Soy Leandro García.</h2><p>Ingeniero en Sistemas · UTN</p><p>Trabajo con vos desde la primera idea hasta la puesta en marcha. Combino ingeniería y diseño para que tu web o sistema sea claro, útil y fácil de usar.</p></div></section>
      <section class="contact" id="contacto"><div class="wrap contact-inner"><div class="new-plan" aria-hidden="true"><span>PRÓXIMO PROYECTO</span><svg viewBox="0 0 240 180" fill="none"><path d="M20 20H220V160H20ZM0 90H240M120 0V180" stroke="currentColor" stroke-dasharray="3 5"/><path d="M92 90H148M120 62V118" stroke="currentColor" stroke-width="2"/></svg><span>EL PUNTO DE PARTIDA LO PONÉS VOS.</span></div><div><h2>Démosle forma<br />a tu <em>próximo proyecto.</em></h2><p>Contame qué tenés en mente o en qué punto estás.<br />Pensemos el próximo paso.</p><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Conversemos por WhatsApp <span aria-hidden="true">↗</span></a><a class="email" href={`mailto:${site.email}`}>{site.email}</a></div></div></section>
    </main>
    <footer class="wrap footer"><span>© {new Date().getFullYear()} LG Design · Leandro García</span><a href="/">Ver versión original <span aria-hidden="true">↗</span></a><span>De la idea a la solución.</span></footer>
    <script>
      import { gsap } from 'gsap';
      const story = document.querySelector<HTMLElement>('.story');
      const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const stage = document.querySelector('[data-stage]');
      const label = document.querySelector('[data-scene-label]');
      const domain = document.querySelector('[data-domain]');
      const english = document.documentElement.lang === 'en';
      const labels = english ? ['IDEA → STRUCTURE', 'STRUCTURE → SYSTEM', 'BLUEPRINT → REALITY', 'IDEA → CONNECTION'] : ['IDEA → ESTRUCTURA', 'ESTRUCTURA → SISTEMA', 'PLANO → REALIDAD', 'IDEA → CONEXIÓN'];
      const stages = english ? ['01 / THE STARTING POINT', '02 / THE RIGHT PIECES', '03 / LIBRERÍA 2001', '04 / VYBE'] : ['01 / EL PUNTO DE PARTIDA', '02 / LAS PIEZAS CORRECTAS', '03 / LIBRERÍA 2001', '04 / VYBE'];
      const domains = [english ? 'A project starts to take shape' : 'Un proyecto empieza a tomar forma', english ? 'Design, features and connections' : 'Diseño, funciones y conexiones', 'libreria2001.com.ar', 'matchvybe.com'];
      const access = document.querySelector<HTMLElement>('.vybe-access');
      const cursor = document.querySelector<HTMLElement>('.demo-cursor');
      const arrival = document.querySelector<HTMLElement>('.vybe-arrival');
      const events = document.querySelector<HTMLElement>('.vybe-events');
      let queued = false;
      let active = -1;
      let sceneTween: gsap.core.Tween | undefined;
      let accessTimeline: gsap.core.Timeline | undefined;
      let scrollTween: gsap.core.Tween | undefined;
      let travelling = false;
      const sceneState = { position: 0 };

      function paint() {
        if (!story) return;
        const p = sceneState.position;
        story.style.setProperty('--layers', String(Math.max(0, 1 - Math.abs(p - 1))));
        story.style.setProperty('--reveal', `${Math.max(0, Math.min(1, p - 1)) * 100}%`);
        story.style.setProperty('--vybe', String(Math.max(0, Math.min(1, p - 2))));
        story.style.setProperty('--progress', `${p / 3 * 100}%`);
        story.style.setProperty('--wire', String(1 - Math.min(1, p)));
      }
      function playAccess() {
        accessTimeline?.kill();
        if (!access || !cursor || !arrival || !events) return;
        gsap.set(access, { opacity: 0, yPercent: 5 });
        gsap.set(arrival, { opacity: 0, scale: 1 });
        gsap.set(events, { opacity: 0, yPercent: 4 });
        gsap.set(cursor, { opacity: 0, x: 30, y: 18 });
        if (active !== 3) return;
        if (reduced.matches) { gsap.set(events, { opacity: 1, yPercent: 0 }); return; }
        accessTimeline = gsap.timeline({ delay: .8 });
        accessTimeline.to(access, { opacity: 1, yPercent: 0, duration: 1.25, ease: 'power3.inOut' });
        accessTimeline.to(cursor, { opacity: 1, x: 0, y: 0, duration: .9, ease: 'power3.out' }, '-=.25');
        accessTimeline.to(cursor, { scale: .85, duration: .2, repeat: 1, yoyo: true }, '+=.5');
        accessTimeline.to(cursor, { opacity: 0, duration: .5 }, '+=.5');
        accessTimeline.to(arrival, { opacity: 1, duration: .5 }, '-=.2');
        accessTimeline.fromTo(arrival.querySelector('strong'), { scale: .82, opacity: .2 }, { scale: 1, opacity: 1, duration: .9, ease: 'power3.out' }, '<');
        accessTimeline.to(events, { opacity: 1, yPercent: 0, duration: 1.15, ease: 'power3.out' }, '+=.55');
      }
      function setPhase(index: number, immediate = false) {
        if (!story || index === active) return;
        active = index;
        story.dataset.active = String(index);
        if (stage) stage.textContent = stages[index];
        if (label) label.textContent = labels[index];
        if (domain) domain.textContent = domains[index];
        sceneTween?.kill();
        accessTimeline?.kill();
        if (access) gsap.set(access, { opacity: 0, yPercent: 5 });
        if (arrival) gsap.set(arrival, { opacity: 0 });
        if (events) gsap.set(events, { opacity: 0 });
        sceneTween = gsap.to(sceneState, { position: index, duration: immediate || reduced.matches ? 0 : 1.65, ease: 'power3.inOut', onUpdate: paint, onComplete: () => { if (index === 3) playAccess(); } });
      }
      function render() {
        queued = false;
        if (travelling) return;
        const focus = window.innerHeight * (window.innerWidth <= 760 ? .72 : .58);
        let index = 0;
        chapters.forEach((chapter, i) => { if (chapter.getBoundingClientRect().top < focus) index = i; });
        setPhase(index);
      }
      function schedule() { if (!queued) { queued = true; requestAnimationFrame(render); } }
      if (story) { story.classList.add('enhanced'); setPhase(0, true); render(); }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      reduced.addEventListener('change', () => {
        scrollTween?.kill(); travelling = false;
        sceneTween?.kill(); accessTimeline?.kill();
        if (access) gsap.set(access, { opacity: 0 });
        if (arrival) gsap.set(arrival, { opacity: 0 });
        if (events) gsap.set(events, { opacity: active === 3 && reduced.matches ? 1 : 0, yPercent: 0 });
        sceneState.position = Math.max(0, active); paint(); schedule();
      });
      document.querySelector('[data-replay]')?.addEventListener('click', playAccess);

      // Wheel gestures work at every viewport width, including the app side panel.
      // Vertical swipes use the same transition; keyboard, zoom and reduced-motion stay native.
      const panels = [...chapters, ...['criterio', 'leandro', 'contacto'].map(id => document.getElementById(id)!)];
      let enteredPanel = -1;
      let entrance: gsap.core.Timeline | undefined;
      function enterPanel(index: number) {
        if (enteredPanel === index) return;
        enteredPanel = index;
        entrance?.progress(1).kill();
        if (reduced.matches) return;
        const panel = panels[index];
        entrance = gsap.timeline();
        if (index < chapters.length) {
          entrance.fromTo(panel.children, { y: 20, opacity: .35 }, { y: 0, opacity: 1, duration: 1.1, stagger: .055, ease: 'expo.out' }, .25);
        } else if (panel.id === 'criterio') {
          entrance.fromTo(panel.querySelectorAll('.process li'), { y: 30, opacity: .2 }, { y: 0, opacity: 1, duration: 1.2, stagger: .15, ease: 'expo.out' });
        } else if (panel.id === 'leandro') {
          entrance.fromTo(panel.querySelector('.personal-mark'), { clipPath: 'inset(0 100% 0 0)', scale: .92 }, { clipPath: 'inset(0 -10% 0 -10%)', scale: 1, duration: 1.5, ease: 'expo.out' });
          entrance.fromTo(panel.querySelector('h2'), { y: 24, opacity: .2 }, { y: 0, opacity: 1, duration: 1.2, ease: 'expo.out' }, .3);
        } else {
          entrance.fromTo(panel.querySelector('.contact-inner'), { y: 32, opacity: .25 }, { y: 0, opacity: 1, duration: 1.4, ease: 'expo.out' });
        }
      }
      const panelObserver = new IntersectionObserver(entries => {
        if (travelling) return;
        const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) enterPanel(panels.indexOf(visible.target as HTMLElement));
      }, { threshold: .55 });
      panels.forEach(panel => panelObserver.observe(panel));
      let gestureUsed = false;
      let wheelQuiet: ReturnType<typeof setTimeout>;
      let wheelTotal = 0;
      const panelTop = (panel: HTMLElement) => {
        if (panel === chapters[0]) return 0;
        const offset = innerWidth <= 760 && chapters.includes(panel)
          ? (document.querySelector<HTMLElement>('.scene')?.offsetHeight ?? 0) : 0;
        return Math.max(0, panel.getBoundingClientRect().top + scrollY - offset);
      };
      function wheelStops() {
        const max = document.documentElement.scrollHeight - innerHeight;
        return panels.map((panel, phase) => ({ y: Math.min(max, panelTop(panel)), phase }));
      }
      function stopTravel() { scrollTween?.kill(); travelling = false; schedule(); }
      function nextPanel(direction: number) {
        const stops = wheelStops();
        // Short screens and enlarged text must remain fully readable.
        // Only overflowing content uses native scrolling; fitted panels have one stop.
        const focus = innerWidth <= 760 ? (document.querySelector<HTMLElement>('.scene')?.offsetHeight ?? 0) + 48 : innerHeight * .45;
        let currentIndex = 0;
        panels.forEach((panel, index) => { if (panel.getBoundingClientRect().top <= (index < chapters.length ? focus : 48)) currentIndex = index; });
        const current = stops[currentIndex];
        if (current) {
          const panel = panels[current.phase];
          const children = Array.from(panel.children).filter(child => !child.classList.contains('fallback-project'));
          const contentBottom = Math.max(...children.map(child => child.getBoundingClientRect().bottom));
          if (direction > 0 && contentBottom > innerHeight + 16) return;
          if (direction < 0 && scrollY > current.y + 16) return;
        }
        const next = stops[currentIndex + direction];
        return next;
      }
      window.addEventListener('wheel', (event) => {
        if (reduced.matches || event.ctrlKey || event.metaKey || !event.deltaY || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
        if ((event.target as Element)?.closest('input,textarea,select,[role="dialog"]')) return;
        const direction = event.deltaY > 0 ? 1 : -1;
        clearTimeout(wheelQuiet);
        wheelQuiet = setTimeout(() => { gestureUsed = false; wheelTotal = 0; }, 220);
        if (travelling || gestureUsed) { event.preventDefault(); return; }
        const next = nextPanel(direction);
        if (!next) return;
        event.preventDefault();
        wheelTotal += event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? innerHeight : 1);
        if (Math.abs(wheelTotal) < 18) return;
        gestureUsed = true;
        travelTo(next);
      }, { passive: false });
      function travelTo(next: { y: number; phase: number }) {
        travelling = true;
        if (next.phase < chapters.length) setPhase(next.phase);
        enterPanel(next.phase);
        const position = { y: scrollY };
        scrollTween = gsap.to(position, { y: next.y, duration: 1.65, ease: 'power3.inOut', onUpdate: () => window.scrollTo({ top: position.y, behavior: 'instant' }), onComplete: () => { travelling = false; schedule(); } });
      }
      let touch: { x: number; y: number; mode: 'pending' | 'native' | 'section' | 'used'; next?: { y: number; phase: number } } | undefined;
      window.addEventListener('touchstart', (event) => {
        touch = undefined;
        if (reduced.matches || event.touches.length !== 1 || (window.visualViewport?.scale ?? 1) > 1.01) return;
        if ((event.target as Element)?.closest('input,textarea,select,[contenteditable],[role="dialog"]')) return;
        const finger = event.touches[0];
        touch = { x: finger.clientX, y: finger.clientY, mode: travelling ? 'used' : 'pending' };
      }, { passive: true });
      window.addEventListener('touchmove', (event) => {
        if (!touch) return;
        if (event.touches.length !== 1 || reduced.matches) { touch = undefined; return; }
        if (touch.mode === 'native') return;
        if (touch.mode === 'used') { if (event.cancelable) event.preventDefault(); return; }
        const dx = event.touches[0].clientX - touch.x;
        const dy = touch.y - event.touches[0].clientY;
        if (touch.mode === 'pending') {
          if (Math.abs(dx) > Math.abs(dy)) { touch.mode = 'native'; return; }
          if (!dy) return;
          touch.next = nextPanel(dy > 0 ? 1 : -1);
          // Oversized content stays native for the entire gesture so nothing is skipped.
          touch.mode = touch.next ? 'section' : 'native';
        }
        if (touch.mode !== 'section' || !touch.next) return;
        if (!event.cancelable) { touch.mode = 'native'; return; }
        event.preventDefault();
        if (Math.abs(dy) < 36) return;
        const next = nextPanel(dy > 0 ? 1 : -1);
        touch.mode = 'used';
        if (next) travelTo(next);
      }, { passive: false });
      window.addEventListener('touchend', () => { touch = undefined; }, { passive: true });
      window.addEventListener('touchcancel', () => { touch = undefined; }, { passive: true });
      window.addEventListener('keydown', stopTravel);
      window.addEventListener('pointerdown', (event) => { if (event.pointerType !== 'touch') stopTravel(); });
      let viewportWidth = innerWidth;
      window.addEventListener('resize', () => {
        // Mobile browser bars resize height during a swipe; let the transition finish.
        if (innerWidth !== viewportWidth) { viewportWidth = innerWidth; touch = undefined; stopTravel(); }
      });
      window.addEventListener('pagehide', () => { stopTravel(); sceneTween?.kill(); accessTimeline?.kill(); clearTimeout(wheelQuiet); entrance?.kill(); panelObserver.disconnect(); });
    </script>
  </body>
</html>
